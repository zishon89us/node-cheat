<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create customer and save a card</title>
  <script src="https://js.stripe.com/endive/stripe.js"></script>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
    label, input, button { display: block; width: 100%; margin-top: .75rem; }
    #payment-element { margin-top: 1rem; }
    #message { margin-top: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body data-publishable-key="<%= publishableKey %>">
  <h1>Save a card for later</h1>
  <p>Test card: 4242 4242 4242 4242, any future date, any CVC.</p>

  <form id="customer-form">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required autocomplete="email">
    <button type="submit">Continue</button>
  </form>

  <form id="setup-form" hidden>
    <div id="payment-element"></div>
    <button type="submit">Save card</button>
  </form>

  <p id="message" role="status"></p>

  <script type="module">
    const stripe = Stripe(document.body.dataset.publishableKey);
    const message = document.getElementById('message');
    const show = (text) => { message.textContent = text; };
    let elements;

    document.getElementById('customer-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const res = await fetch('/customer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: event.target.email.value, description: 'Created from node-cheat' }),
      });
      const data = await res.json();
      if (!res.ok) return show(data.error);

      elements = stripe.elements({ clientSecret: data.clientSecret });
      elements.create('payment').mount('#payment-element');
      event.target.hidden = true;
      document.getElementById('setup-form').hidden = false;
      show(`Customer ${data.customer.id} created. Enter card details.`);
    });

    document.getElementById('setup-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const { error, setupIntent } = await stripe.confirmSetup({ elements, redirect: 'if_required' });
      if (error) return show(error.message);
      show(`Saved payment method ${setupIntent.payment_method}. Use it with POST /charge-immediate.`);
      event.target.querySelector('button').disabled = true;
    });
  </script>
</body>
</html>
