<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create a PaymentMethod from card details</title>
  <script src="https://js.stripe.com/endive/stripe.js"></script>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 28rem; margin: 3rem auto; padding: 0 1rem; }
    button { display: block; width: 100%; margin-top: 1rem; }
    #message { margin-top: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body data-publishable-key="<%= publishableKey %>">
  <h1>Card details to PaymentMethod</h1>
  <p>Replaces the old Stripe.js v2 card tokens. Test card: 4242 4242 4242 4242.</p>

  <form id="payment-form">
    <div id="payment-element"></div>
    <button type="submit">Create PaymentMethod</button>
  </form>
  <p id="message" role="status"></p>

  <script type="module">
    const stripe = Stripe(document.body.dataset.publishableKey);
    const message = document.getElementById('message');
    const elements = stripe.elements({ mode: 'setup', currency: 'usd', paymentMethodCreation: 'manual' });
    elements.create('payment').mount('#payment-element');

    document.getElementById('payment-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const { error: submitError } = await elements.submit();
      if (submitError) return (message.textContent = submitError.message);

      const { error, paymentMethod } = await stripe.createPaymentMethod({ elements });
      // Send paymentMethod.id to POST /add-card to attach it to a customer.
      message.textContent = error ? error.message : `PaymentMethod: ${paymentMethod.id}`;
    });
  </script>
</body>
</html>
