{
  "name": "SecureAI Security Scanner",
  "url": "https://github.com/zishon89us/node-cheat/tree/master/secureai",
  "hook_attributes": {
    "url": "https://YOUR-DEPLOYMENT-HOST/webhooks/github"
  },
  "description": "Scans pull requests for common security issues and reports them as a PR comment and check run.",
  "public": false,
  "default_events": ["pull_request", "push"],
  "default_permissions": {
    "contents": "read",
    "metadata": "read",
    "pull_requests": "write",
    "checks": "write"
  }
}
