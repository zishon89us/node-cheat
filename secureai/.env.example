# GitHub App (required)
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# Either a path to the PEM file...
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# ...or the PEM itself (raw, with \n escapes, or base64-encoded), for container/PaaS deploys
# GITHUB_PRIVATE_KEY=

# Claude triage (optional; without it every regex finding is reported as-is)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_MAX_FINDINGS=50

# Manual POST /scan endpoint (optional; enabled only when both are set)
# GITHUB_TOKEN=
# SCAN_API_KEY=at-least-16-random-characters

PORT=3000
