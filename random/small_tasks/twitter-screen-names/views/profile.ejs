<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Twitter Handles</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
</head>
<body class="py-5">
<main class="container">
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1>Hello, <%= user.name %>!</h1>
		<form action="/logout" method="post"><button class="btn btn-outline-secondary btn-sm">Logout</button></form>
	</div>

	<form action="/twitter/usernames" method="get" class="row g-2 mb-4">
		<div class="col-lg-6">
			<label for="sheet" class="form-label">Public Google Sheet id</label>
			<input id="sheet" name="sheet" type="text" class="form-control" required pattern="[A-Za-z0-9_\-]{20,100}"
			       placeholder="e.g. 1n7DxgJTTHZ9w3xwiHokUhXMLkBwpP5c9ZLFmsYFDCic">
		</div>
		<div class="col-12">
			<button class="btn btn-primary">Get Twitter handles</button>
		</div>
	</form>

	<form action="/unlink/twitter" method="post">
		<button class="btn btn-warning btn-sm">Unlink X account</button>
	</form>
</main>
</body>
</html>
