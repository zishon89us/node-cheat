<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Node Social</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css">
</head>
<body class="py-5">
<main class="container text-center">
	<div class="p-5 bg-body-tertiary rounded-3">
		<h1>Node Authentication</h1>
		<p>Login or register with:</p>
		<% if (facebook) { %>
			<a href="/auth/facebook" class="btn btn-primary">Facebook</a>
		<% } %>
		<% if (twitter) { %>
			<a href="/auth/twitter" class="btn btn-dark">X (Twitter)</a>
		<% } %>
	</div>
</main>
</body>
</html>
