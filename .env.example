# Copy to .env and fill in only what the example you run needs, then:
#   node --env-file=.env path/to/example.js
# Sub-apps under auth/passport-x-* and stackoverflow_answers/express-loading-stuck
# have their own .env.example.

# Common
PORT=3000

# AWS — credentials come from the default provider chain (aws configure / AWS_PROFILE / IAM role)
AWS_REGION=us-east-1
S3_BUCKET=
DEST_BUCKET=
SQS_QUEUE_URL=
STATE_MACHINE_ARN=

# TLS (web/https/) — generate a local pair with the command in web/https/README.md
SSL_KEY_PATH=./web/https/keys/key.pem
SSL_CERT_PATH=./web/https/keys/cert.pem

# Stripe (payments/)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# SendGrid (messaging/email/)
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_TO=
CONTACT_EMAIL=
EVENT_WEBHOOK_URL=

# Twilio (messaging/sms/)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telnyx fax (messaging/fax/)
TELNYX_API_KEY=
TELNYX_FAX_CONNECTION_ID=
TELNYX_FAX_FROM=

# Push notifications (messaging/push/)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
APNS_KEY_PATH=./AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# Databases
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=node-cheat
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_BYTES=10485760

# Media / scraping
FFMPEG_PATH=ffmpeg
SCRAPE_URL=https://example.com
SCRAPE_SELECTOR=h1

# X (Twitter) API (auth/, apis/)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Other APIs (apis/, utilities/)
OPENEXCHANGERATES_APP_ID=
NAMSOR_API_KEY=
BANDSINTOWN_APP_ID=
OPENWEATHER_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SCOPES=
BASE_URL=http://localhost:3000
HMAC_SECRET=

# stackoverflow_answers/crypto-create-cipheriv.js
ENCRYPTION_PASSWORD=
